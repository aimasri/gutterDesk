#---------------------------------------------
# TINT2 CONFIG FILE
#---------------------------------------------
# For more information about tint2, see:
# http://code.google.com/p/tint2/wiki/Welcome
#
# For more info on configuring tint2, see:
# https://code.google.com/p/tint2/wiki/Configure

# Background definitions
# ID 1 - main panel background (stealth midnight forest green)
rounded = 0
border_width = 1
background_color = #060d08 60
border_color = #122117 35

# ID 2 - task active (deep muted forest highlight)
rounded = 1
border_width = 1
background_color = #183321 50
border_color = #2c5438 50

# ID 3 - task
rounded = 1
border_width = 0
background_color = #000000 0
border_color = #000000 0

# ID 4
rounded = 1
border_width = 1
background_color = #888888 20
border_color = #ED2323 60

# ID 5 - taskbar
rounded = 0
border_width = 1
background_color = #000000 0
border_color = #000000 0

# ID 6 - active taskbar / workspace indicator
rounded = 0
border_width = 1
background_color = #183321 30
border_color = #24422e 40

# ID 7 - tooltip
rounded = 3
border_width = 0
background_color = #222222 90
border_color = #222222 90

# ID 8
rounded = 1
border_width = 1
background_color = #888888 20
border_color = #888888 20

# Panel
panel_monitor = primary
panel_position = bottom center horizontal
panel_items = TSEBC
panel_size = 100% 30
panel_margin = 0 -1
panel_padding = 0 0
panel_dock = 0
wm_menu = 1
panel_layer = top
panel_background_id = 1

# Panel Autohide
autohide = 0
autohide_show_timeout = 0.3
autohide_hide_timeout = 0.8
autohide_height = 3
strut_policy = follow_size

# Taskbar
taskbar_mode = multi_desktop
taskbar_padding = 6 0 6
taskbar_background_id = 5
taskbar_active_background_id = 6
taskbar_name = 1
taskbar_name_background_id = 0
taskbar_name_active_background_id = 0
taskbar_name_font = Liberation Sans 9
taskbar_name_font_color = #546b5d 100
taskbar_name_active_font_color = #629e79 100

# Tasks
urgent_nb_of_blink = 20
task_icon = 1
task_text = 0
task_centered = 1
task_maximum_size = 40 40
task_padding = 2 2
task_background_id = 3
task_active_background_id = 2
task_urgent_background_id = 4
task_iconified_background_id = 3

# Task Icons
task_icon_asb = 80 0 0
task_active_icon_asb = 100 0 0
task_urgent_icon_asb = 100 0 0
task_iconified_icon_asb = 80 0 0

# Fonts
task_font = Liberation Sans 06_55 6
task_font_color = #828282 60
task_active_font_color = #828282 100
task_urgent_font_color = #FFFFFF 100
task_iconified_font_color = #d8d8d8 60
font_shadow = 0

# Launcher
launcher_padding = 8 4 4
launcher_background_id = 0
launcher_icon_size = 24
# Specify icon theme names with launcher_icon_theme. 
launcher_icon_theme = Papirus-Dark
# Each launcher_item_app must be a full path to a .desktop file
launcher_item_app = /usr/share/applications/guake.desktop
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/geany.desktop
launcher_item_app = /usr/share/applications/google-chrome.desktop
launcher_item_app = /usr/share/applications/antigravity.desktop

# System Tray
systray = 1
systray_padding = 4 2 3
systray_sort = right2left
systray_background_id = 0
systray_icon_size = 24
systray_icon_asb = 100 0 0
systray_monitor = primary

# Clock
time1_format = %H:%M
time1_font = Liberation Sans Bold 10
time2_format = %a %d %b
time2_font = Liberation Sans 8
clock_font_color = #f8fafc 100
clock_padding = 10 0
clock_background_id = 0
clock_lclick_command = gsimplecal
clock_rclick_command = gsimplecal

# Tooltips
tooltip = 1
tooltip_padding = 4 3
tooltip_show_timeout = 0.1
tooltip_hide_timeout = 0.1
tooltip_background_id = 7
tooltip_font_color = #f8fafc 100
tooltip_font = Liberation Sans 9

# Mouse
mouse_middle = none
mouse_right = toggle
mouse_scroll_up = toggle
mouse_scroll_down = iconify

# Battery
battery_hide = 101
battery_low_status = 20
battery_low_cmd = notify-send -u critical "Battery Low" "Battery level is under 20%"
battery_full_cmd = notify-send "Battery Charged" "Battery is fully charged"
bat1_font = Liberation Sans Bold 8
bat2_font = Liberation Sans 7
battery_font_color = #f8fafc 100
bat1_format = %p
bat2_format = %t
battery_padding = 8 0
battery_background_id = 0
battery_tooltip_enabled = 1
ac_connected_cmd = notify-send "Power Connected" "AC adapter plugged in"
ac_disconnected_cmd = notify-send "Power Disconnected" "Running on battery"

#---------------------------------------------
# Executor 1 - Network (Wi-Fi / Ethernet status)
#---------------------------------------------
execp = new
execp_command = ~/.local/bin/tint2-network.sh
execp_interval = 3
execp_has_icon = 1
execp_cache_icon = 0
execp_continuous = 0
execp_markup = 1
execp_lclick_command = iwgtk
execp_rclick_command = iwgtk
execp_padding = 4 0 0
execp_background_id = 0
execp_centered = 1
execp_icon_w = 20
execp_icon_h = 20

# End of config

