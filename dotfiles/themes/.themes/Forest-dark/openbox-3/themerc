!! Theme: Forest-dark (Darker Midnight Edition)
!! Description: Stealth midnight forest green dark theme for Openbox

!! Menu settings
menu.title.bg: flat gradient vertical bevel1
menu.title.bg.color: #101913
menu.title.bg.colorTo: #0b120e
menu.title.text.color: #cfded5
menu.title.text.justify: right

menu.separator.color: #18261e

menu.items.bg: flat solid
menu.items.bg.color: #0d1611
menu.items.text.color: #c0d1c6
menu.items.disabled.text.color: #43544a

menu.items.active.bg: flat solid
menu.items.active.bg.color: #1b3626
menu.items.active.bg.colorTo: #1b3626
menu.items.active.text.color: #ffffff
menu.bullet.selected.image.color: #64a880

!! focused window settings
window.active.title.bg: raised
window.active.title.bg.color: #101913
window.active.handle.bg: raised
window.active.handle.bg.color: #101913
window.active.grip.bg: parentrelative
window.active.label.bg: parentrelative
window.active.label.text.color: #c0d1c6
window.*.button.*.bg: parentrelative
window.active.button.*.image.color: #6b8f79
window.active.button.*.pressed.image.color: #ffffff
window.active.button.disabled.image.color: #35453b

!! unfocused window settings
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #090e0b

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #4d5e53

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #070b09

window.inactive.grip.bg: parentrelative

!! Global width settings
border.Width: 1
padding.width: 1
window.handle.width: 4
window.client.padding.width: 0
menu.overlap.x: -6

!! Miscellaneous settings
border.color: #142118
menu.border.color: #18261d

!! OSD
osd.bg: flat gradient vertical bevel1
osd.bg.color: #0a110d
osd.bg.colorTo: #070c09
osd.label.bg: parentrelative
osd.hilight.bg: flat solid
osd.hilight.bg.color: #1b3626
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #35453b
osd.label.text.color: #cfded5

window.label.text.justify: center
