<?xml version='1.0' encoding='UTF-8'?>
<openbox_menu xmlns="http://openbox.org/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://openbox.org/                 file:///usr/share/openbox/menu.xsd">
  <menu id="root-menu" label="Openbox 3">
    <item label="Run Program">
      <action name="Execute">
        <execute>gmrun</execute>
      </action>
    </item>
    <separator/>
    <item label="Launch Workspace">
      <action name="Execute">
        <execute>sh -c '[ -x "$HOME/.local/bin/setup-workspace.sh" ] &amp;&amp; "$HOME/.local/bin/setup-workspace.sh"'</execute>
      </action>
    </item>
	<item label="Banyan Trading">
		<action name="Execute">
			<execute>sh -c '[ -x "$HOME/projects/Banyan/desktop/build/banyan_daemon" ] &amp;&amp; "$HOME/projects/Banyan/desktop/build/banyan_daemon" --show || banyan_daemon --show'</execute>
		</action>
	</item>
    <separator/>
    <item label="Antigravity">
      <action name="Execute">
        <execute>antigravity</execute>
      </action>
    </item>
    <item label="gutterDeck">
      <action name="Execute">
        <execute>gutterdeck</execute>
      </action>
    </item>
    <item label="gutterTab">
      <action name="Execute">
        <execute>gutterTab</execute>
      </action>
    </item>
    <separator/>
    <item label="Selected Area...">
      <action name="Execute">
        <execute>scrot -s '%Y-%m-%d--%s_$wx$h_scrot.png' -e 'mv $f ~/images/ &amp;&amp; viewnior ~/images/$f'</execute>
      </action>
    </item>
    <menu id="graphicsScreenshots" label="Take Screenshot">
      <item label="Now">
        <action name="Execute">
          <execute>scrot '%Y-%m-%d--%s_$wx$h_scrot.png' -e 'mv $f ~/images/ &amp;&amp; viewnior ~/images/$f'</execute>
        </action>
      </item>
      <item label="In 5 Seconds...">
        <action name="Execute">
          <execute>scrot -d 5 '%Y-%m-%d--%s_$wx$h_scrot.png' -e 'mv $f ~/images/ &amp;&amp; viewnior ~/images/$f'</execute>
        </action>
      </item>
      <item label="In 10 Seconds...">
        <action name="Execute">
          <execute>scrot -d 10 '%Y-%m-%d--%s_$wx$h_scrot.png' -e 'mv $f ~/images/ &amp;&amp; viewnior ~/images/$f'</execute>
        </action>
      </item>
      <item label="Selected Area...">
        <action name="Execute">
          <execute>scrot -s '%Y-%m-%d--%s_$wx$h_scrot.png' -e 'mv $f ~/images/ &amp;&amp; viewnior ~/images/$f'</execute>
        </action>
      </item>
      <separator/>
      <item label="Screenshooter">
        <action name="Execute">
          <execute>xfce4-screenshooter</execute>
        </action>
      </item>
