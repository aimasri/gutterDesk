## Openbox autostart
## =================

## Set monitors layout if configured
[ -f ~/.screenlayout/default.sh ] && ~/.screenlayout/default.sh
xrdb -merge ~/.Xresources &

## XSETTINGS daemon (propagates GTK & Papirus-Dark icon theme to tray applets)
which xsettingsd >/dev/null 2>&1 && (xsettingsd &)

## LX PolicyKit
lxpolkit &

## Sequential Desktop Group Start:
## 1. Auto-detect orientation and apply matching wallpapers (backgrounded)
([ -x ~/.local/bin/auto-wallpaper.sh ] && ~/.local/bin/auto-wallpaper.sh || (nitrogen --restore &)) &

## 2. Start compositor (picom)
which picom >/dev/null 2>&1 && (picom -b &) || (which cbpp-compositor >/dev/null 2>&1 && cbpp-compositor --start &)

## 3. Start tint2 panel (delayed 1s for compositing)
(sleep 1s && tint2) &

## 4. Start Wireless network indicator daemon (iwd + iwgtk)
which iwgtk >/dev/null 2>&1 && (iwgtk -i &)

## 5. Dropdown terminal daemon (guake)
if which guake >/dev/null 2>&1; then
    [ -f ~/.config/guake/guake-preferences.ini ] && which dconf >/dev/null 2>&1 && dconf load /org/guake/ < ~/.config/guake/guake-preferences.ini 2>/dev/null || true
    guake &
fi

## 6. Volume keys and systray icon
which volumeicon >/dev/null 2>&1 && (volumeicon &)

## 7. Bluetooth manager applet
which blueman-applet >/dev/null 2>&1 && (blueman-applet &)

## 8. Start PCManFM Daemon for instant file management
pcmanfm -d &

## Native DPMS power management (clean fade-to-black after 10m idle)
xset s 600 600 &
xset dpms 600 900 1200 &
xset s blank &

## 10. Clipboard manager
which parcellite >/dev/null 2>&1 && (sleep 2s && parcellite) &

## 11. Banyan Desktop System Tray Daemon (if installed)
[ -f ~/.config/systemd/user/banyan-desktop.service ] && (sleep 3s && systemctl --user start banyan-desktop.service) &

## Keyboard repeat rate settings
xset r rate 250 25 &
xset b off &

## Notifications
/usr/lib/*/xfce4/notifyd/xfce4-notifyd &
