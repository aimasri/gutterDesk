## Openbox autostart
## =================

## Update D-Bus and systemd user session environment
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP
fi
export GTK_USE_PORTAL=0

## Set monitors layout if configured
[ -f ~/.screenlayout/default.sh ] && (~/.screenlayout/default.sh &)
xrdb -merge ~/.Xresources &

## XSETTINGS daemon (propagates GTK & Papirus-Dark icon theme to tray applets)
which xsettingsd >/dev/null 2>&1 && (xsettingsd &)

## PolicyKit Authentication Agent
which lxpolkit >/dev/null 2>&1 && (lxpolkit &)

## GNOME Keyring Daemon (Secret Storage for Antigravity, VS Code, Git)
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
    eval $(gnome-keyring-daemon --start --components=secrets 2>/dev/null)
    [ -n "$SSH_AUTH_SOCK" ] && export SSH_AUTH_SOCK
fi

## Sequential Desktop Group Start:
## 1. Auto-detect orientation and apply matching wallpapers (backgrounded)
([ -x ~/.local/bin/auto-wallpaper.sh ] && ~/.local/bin/auto-wallpaper.sh || (nitrogen --restore &)) &

## 2. Start compositor (picom)
which picom >/dev/null 2>&1 && (picom -b &)

## 3. Start tint2 panel (delayed 1s for compositing)
(sleep 1s && tint2) &

## 4. Dropdown terminal daemon (guake)
if which guake >/dev/null 2>&1; then
    ([ -f ~/.config/guake/guake-preferences.ini ] && which dconf >/dev/null 2>&1 && dconf load /org/guake/ < ~/.config/guake/guake-preferences.ini 2>/dev/null; guake) &
fi

## 6. Volume keys and systray icon
which volumeicon >/dev/null 2>&1 && (volumeicon &)

## 7. Bluetooth manager applet
which blueman-applet >/dev/null 2>&1 && (blueman-applet &)

## 8. Start PCManFM Daemon for instant file management
which pcmanfm >/dev/null 2>&1 && (pcmanfm -d &)

## 9. Screen lock daemon (delegates lock screen to LightDM greeter)
which light-locker >/dev/null 2>&1 && (light-locker --lock-on-suspend --lock-on-lid --no-late-locking &)

## Native DPMS power management (clean fade-to-black after 10m idle)
xset s 600 600 &
xset dpms 600 900 1200 &
xset s blank &

## 10. Clipboard manager
which parcellite >/dev/null 2>&1 && (sleep 2s && parcellite) &

## 11. Banyan Desktop System Tray Daemon (if installed)
[ -f ~/.config/systemd/user/banyan-desktop.service ] && (sleep 3s && systemctl --user start banyan-desktop.service) &

## Keyboard repeat rate settings
xset r rate 250 25 &
xset b off &

## Notifications
for notifyd in /usr/lib/*/xfce4/notifyd/xfce4-notifyd /usr/lib/xfce4-notifyd/xfce4-notifyd; do
    [ -x "$notifyd" ] && "$notifyd" &
done

## 12. First-boot modular installer prompt
[ -x ~/.local/bin/gutterdesk-first-run.sh ] && (~/.local/bin/gutterdesk-first-run.sh &)

