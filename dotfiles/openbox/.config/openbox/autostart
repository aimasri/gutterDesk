## Openbox autostart
## =================

## Set monitors layout if configured
[ -f ~/.screenlayout/default.sh ] && ~/.screenlayout/default.sh
xrdb -merge ~/.Xresources &

## LX PolicyKit
lxpolkit &

## Sequential Desktop Group Start:
## 1. Auto-detect orientation and apply matching wallpapers
[ -x ~/.local/bin/auto-wallpaper.sh ] && ~/.local/bin/auto-wallpaper.sh || (nitrogen --restore &)

## 2. Start compositor (picom)
which picom >/dev/null 2>&1 && (picom -b &) || (which cbpp-compositor >/dev/null 2>&1 && cbpp-compositor --start &)

## 3. Start tint2 panel (delayed 1s for compositing)
(sleep 1s && tint2) &

## 4. Start Network Manager applet
nm-applet &

## 5. Volume keys daemon
which mate-volume-control-status-icon >/dev/null 2>&1 && mate-volume-control-status-icon &

## 6. Power management
which mate-power-manager >/dev/null 2>&1 && mate-power-manager &

## 7. Start PCManFM Daemon for instant file management
pcmanfm -d &

## 8. Screen lock daemon
xscreensaver -no-splash &

## 9. Clipboard manager
which parcellite >/dev/null 2>&1 && (sleep 2s && parcellite) &

## 10. Start custom productivity utilities (gutterDeck and gutterTab)
(sleep 2s && [ -x ~/.local/bin/gutterdeck ] && ~/.local/bin/gutterdeck) &
(sleep 2s && [ -x ~/.local/bin/gutterTab ] && ~/.local/bin/gutterTab) &

## 11. Banyan Desktop System Tray Daemon (if installed)
[ -f ~/.config/systemd/user/banyan-desktop.service ] && (sleep 3s && systemctl --user start banyan-desktop.service) &

## Keyboard repeat rate settings
xset r rate 250 25 &
xset b off &

## Notifications
/usr/lib/*/xfce4/notifyd/xfce4-notifyd &
